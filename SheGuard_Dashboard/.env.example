# SheGuard Dashboard Configuration

# Backend API base URL - REQUIRED
# Set this to your backend server address (e.g., http://192.168.1.100:8000 or https://api.example.com)
VITE_API_BASE_URL=http://localhost:8000

# Optional: Override WebSocket URL (defaults to ws:// or wss:// based on API URL)
# VITE_WS_BASE_URL=ws://localhost:8000

# Optional: Media/Uploads base URL (defaults to VITE_API_BASE_URL)
# VITE_MEDIA_BASE_URL=http://localhost:8000
