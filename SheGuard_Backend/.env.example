SHEGUARD_DB_PATH=sheguard.db
SHEGUARD_JWT_SECRET=replace-with-a-long-random-secret
SHEGUARD_TOKEN_TTL_SECONDS=86400
SHEGUARD_SERVICE_TOKEN=replace-with-a-secret-for-ai-engine-ingest
SHEGUARD_CORS_ORIGINS=*

# Telegram Bot API
# BOT_TOKEN is created with @BotFather.
# PARENT_CHAT_ID is the chat/user/group that receives emergency alerts.
BOT_TOKEN=
PARENT_CHAT_ID=

# Backward-compatible Telegram names also supported:
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_API_KEY=
NVIDIA_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
